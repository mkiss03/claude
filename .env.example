# ============================================
# TemetkezésPro - Environment Variables
# ============================================
# Másolja át ezt a fájlt .env néven és töltse ki a megfelelő értékekkel
# FONTOS: A .env fájlt NE commitolja a git-be!

# --------------------------------------------
# Site Configuration
# --------------------------------------------
# A weboldal teljes URL-je (trailing slash nélkül)
PUBLIC_SITE_URL=https://temetkezespro.hu

# Kapcsolati információk
PUBLIC_CONTACT_EMAIL=info@temetkezespro.hu
PUBLIC_CONTACT_PHONE=+36 30 123 4567

# --------------------------------------------
# Lead Form Configuration
# --------------------------------------------
# Válassza ki a lead kezelés módját: 'make' vagy 'resend'
LEAD_MODE=make

# Make.com webhook URL (ha LEAD_MODE=make)
# Lépések:
# 1. Jelentkezzen be Make.com-ba
# 2. Hozzon létre új scenariot "Webhooks" triggerrel
# 3. Másolja ide a kapott webhook URL-t
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/xxxxxxxxxxxxxxxxx

# Resend API konfiguráció (ha LEAD_MODE=resend)
# Lépések:
# 1. Regisztráljon Resend.com-on
# 2. Domain hitelesítés (DNS beállítások)
# 3. API kulcs generálás
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LEAD_TO_EMAIL=info@temetkezespro.hu
LEAD_FROM_EMAIL=noreply@temetkezespro.hu

# CSRF védelem - engedélyezett origin-ek (vesszővel elválasztva)
# Hagyd üresen ha nincs CSRF ellenőrzés (nem ajánlott production-ben!)
ALLOWED_ORIGINS=temetkezespro.hu,www.temetkezespro.hu,localhost

# --------------------------------------------
# Calendly / Cal.com Integration
# --------------------------------------------
# Időpontfoglalás link (Calendly, Cal.com, stb.)
# Például: https://calendly.com/temetkezespro/demo
# Vagy: https://cal.com/temetkezespro/30min
PUBLIC_CAL_URL=https://calendly.com/your-username/demo

# --------------------------------------------
# Analytics Configuration
# --------------------------------------------
# Vercel Analytics (automatikus, ha Vercel-en futtatod)
PUBLIC_ENABLE_VERCEL_ANALYTICS=true

# Plausible Analytics (privacy-friendly alternatíva)
# Ha használod, add meg a domain-t amit követsz
PUBLIC_ENABLE_PLAUSIBLE=false
PUBLIC_PLAUSIBLE_DOMAIN=temetkezespro.hu

# Google Analytics 4 (opcionális, ha szeretnéd)
# PUBLIC_GA4_ID=G-XXXXXXXXXX

# --------------------------------------------
# Development Mode
# --------------------------------------------
# NODE_ENV automatikusan beállítódik, de felülírhatod
# NODE_ENV=development
