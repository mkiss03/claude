# TemetkezésPro - Environment Variables
#
# GYORS INDÍTÁS:
# 1. Másold le ezt a fájlt .env.local néven
# 2. Töltsd ki a LEAD_MODE-ot ('make' vagy 'resend')
# 3. Állítsd be a megfelelő webhook/email konfigurációt
# 4. npm run dev

# ---------------------------------
# 📋 Lead Submission Method (KÖTELEZŐ!)
# ---------------------------------
# Válaszd ki, hogyan szeretnéd fogadni az űrlap beküldéseket:
# - 'make' = Make.com webhook (ajánlott, könnyebb integráció)
# - 'resend' = Resend email szolgáltatás
LEAD_MODE=make

# ---------------------------------
# 🔗 Make.com Configuration
# ---------------------------------
# Ha LEAD_MODE=make, akkor ez KÖTELEZŐ!
# Lépések:
# 1. Menj a https://make.com oldalra
# 2. Hozz létre új Scenario-t
# 3. Adj hozzá Webhook trigger-t
# 4. Másold ki a webhook URL-t ide:
MAKE_WEBHOOK_URL=hsuw9ump0ue7h29edkuo6be5bl8ruyh8@hook.eu2.make.com

# ---------------------------------
# 📧 Resend Configuration
# ---------------------------------
# Ha LEAD_MODE=resend, akkor ezek KÖTELEZŐK!
# Lépések:
# 1. Regisztrálj a https://resend.com oldalon
# 2. Igazold a domain-edet (pl. temetkezespro.hu)
# 3. Hozz létre API kulcsot
# 4. Töltsd ki az alábbi mezőket:

# API kulcs (pl: re_123abc...)
RESEND_API_KEY=re_your_api_key_here

# Feladó email címe (igazolt domain kell!)
RESEND_FROM=TemetkezésPro <hello@temetkezespro.hu>

# Címzett email címe (ide érkeznek a lead-ek)
RESEND_TO=info@temetkezespro.hu

# ---------------------------------
# 🔒 Security (OPCIONÁLIS)
# ---------------------------------
# CSRF védelem: csak ezekről a domain-ekről fogadunk el kéréseket
# Vesszővel elválasztva add meg a domain-eket
# Példa: temetkezespro.hu,www.temetkezespro.hu
# Ha üresen hagyod = minden origin elfogadva (dev-hez OK, production-nél NEM ajánlott!)
ALLOWED_ORIGINS=

# ---------------------------------
# 📊 Analytics (OPCIONÁLIS)
# ---------------------------------
# Plausible Analytics használata esetén add meg a domain-edet:
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=temetkezespro.hu

# Vercel Analytics automatikusan működik Vercel deployment esetén
# Nincs szükség külön konfigurációra!
