# TemetkezésPro - Environment Variables

# ---------------------------------
# Lead Submission Method
# ---------------------------------
# Options: 'make' (Make.com webhook) or 'resend' (Resend email)
LEAD_MODE=make

# ---------------------------------
# Make.com Configuration
# ---------------------------------
# Your Make.com webhook URL (if using LEAD_MODE=make)
# Get this from your Make.com scenario
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id

# ---------------------------------
# Resend Configuration
# ---------------------------------
# Your Resend API key (if using LEAD_MODE=resend)
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender email address (must be verified domain in Resend)
RESEND_FROM=TemetkezésPro <hello@temetkezespro.hu>

# Recipient email address (where leads will be sent)
RESEND_TO=info@temetkezespro.hu

# ---------------------------------
# Security
# ---------------------------------
# Comma-separated list of allowed origins for CSRF protection
# Example: temetkezespro.hu,www.temetkezespro.hu
# Leave empty to allow all origins (not recommended for production)
ALLOWED_ORIGINS=temetkezespro.hu

# ---------------------------------
# Analytics (Optional)
# ---------------------------------
# Plausible Analytics domain (if using Plausible)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=temetkezespro.hu

# Vercel Analytics is enabled by default when deployed to Vercel
# No additional configuration needed
