---
import { ArrowRight, Calendar } from 'lucide-astro';

const calUrl = import.meta.env.PUBLIC_CAL_URL || '#';
---

<section class="section bg-gradient-to-b from-primary-50 to-white">
  <div class="container-custom">
    <div class="max-w-4xl mx-auto text-center space-y-8">
      <!-- Badge -->
      <div class="inline-flex items-center px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold">
        🚀 Modern digitális megoldások temetkezési vállalkozásoknak
      </div>

      <!-- Main Heading -->
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-secondary-900 leading-tight">
        Tegye <span class="text-primary-600">digitálissá</span> temetkezési vállalkozását
      </h1>

      <!-- Subheading -->
      <p class="text-xl md:text-2xl text-secondary-600 max-w-3xl mx-auto leading-relaxed">
        Belső elhunyt- és ügyfél-nyilvántartás hivatalos irat-előkészítéssel.
        Nem kapcsolódunk közvetlenül az e-Anyakönyvhöz – az anyakönyvi bejelentéshez szükséges dokumentumokat automatikusan előkészítjük.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-4">
        <a href="#kapcsolat" class="btn-primary w-full sm:w-auto group">
          Kérek visszahívást
          <ArrowRight class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" />
        </a>
        <a
          href={calUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline w-full sm:w-auto group"
        >
          <Calendar class="w-5 h-5 mr-2" />
          Demó időpont foglalás
        </a>
      </div>

      <!-- Social Proof / Trust Indicators -->
      <div class="pt-8 md:pt-12">
        <div class="grid grid-cols-3 gap-8 max-w-2xl mx-auto">
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-primary-600">Pilot</div>
            <div class="text-sm md:text-base text-secondary-600 mt-1">Partnereket keresünk</div>
          </div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-primary-600">2026</div>
            <div class="text-sm md:text-base text-secondary-600 mt-1">Célunk 50+ partner</div>
          </div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-primary-600">Pro+</div>
            <div class="text-sm md:text-base text-secondary-600 mt-1">24/7 támogatás tervben</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
