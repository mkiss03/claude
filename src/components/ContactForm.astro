---
import { Send } from 'lucide-astro';
---

<section id="kapcsolat" class="section bg-gradient-to-b from-white to-primary-50">
  <div class="container-custom">
    <div class="max-w-3xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-5xl font-bold text-secondary-900 mb-6">
          Kérjen visszahívást
        </h2>
        <p class="text-lg md:text-xl text-secondary-600">
          Töltse ki az alábbi űrlapot, és kollégáink 24 órán belül felveszik Önnel a kapcsolatot.
        </p>
      </div>

      <!-- Contact Form -->
      <div class="card">
        <form id="contact-form" class="space-y-6">
          <!-- Company Name -->
          <div>
            <label for="company" class="block text-sm font-semibold text-secondary-900 mb-2">
              Cégnév <span class="text-red-600">*</span>
            </label>
            <input
              type="text"
              id="company"
              name="company"
              required
              class="input"
              placeholder="pl. Temetkezési Szolgáltatás Kft."
            />
          </div>

          <!-- City -->
          <div>
            <label for="city" class="block text-sm font-semibold text-secondary-900 mb-2">
              Település <span class="text-red-600">*</span>
            </label>
            <input
              type="text"
              id="city"
              name="city"
              required
              class="input"
              placeholder="pl. Budapest"
            />
          </div>

          <!-- Contact Name -->
          <div>
            <label for="name" class="block text-sm font-semibold text-secondary-900 mb-2">
              Kapcsolattartó neve <span class="text-red-600">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="input"
              placeholder="pl. Kovács János"
            />
          </div>

          <!-- Phone -->
          <div>
            <label for="phone" class="block text-sm font-semibold text-secondary-900 mb-2">
              Telefonszám <span class="text-red-600">*</span>
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              class="input"
              placeholder="pl. +36 30 123 4567"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-semibold text-secondary-900 mb-2">
              E-mail cím <span class="text-red-600">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="input"
              placeholder="pl. kovacs.janos@vallakozes.hu"
            />
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block text-sm font-semibold text-secondary-900 mb-2">
              Megjegyzés (opcionális)
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="textarea"
              placeholder="Írja le röviden igényeit, kérdéseit..."
            ></textarea>
          </div>

          <!-- Privacy Consent -->
          <div class="flex items-start">
            <input
              type="checkbox"
              id="privacy"
              name="privacy"
              required
              class="checkbox mt-1"
            />
            <label for="privacy" class="ml-3 text-sm text-secondary-700">
              Elfogadom az <a href="/adatkezeles" class="text-primary-600 hover:text-primary-700 underline">adatkezelési tájékoztatót</a>.
              Hozzájárulok, hogy a megadott adataimat a TemetkezésPro felhasználja a kapcsolatfelvétel céljából.
              <span class="text-red-600">*</span>
            </label>
          </div>

          <!-- Error Message -->
          <div id="form-error" class="hidden p-4 bg-red-50 border-2 border-red-200 rounded-lg text-red-700">
            <p class="font-semibold">Hiba történt az űrlap küldése közben.</p>
            <p class="text-sm mt-1">Kérjük, próbálja újra később, vagy írjon nekünk közvetlenül az info@temetkezespro.hu címre.</p>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="submit-button"
            class="btn-primary w-full group"
          >
            <span id="button-text">
              Küldés
              <Send class="w-5 h-5 ml-2 inline-block group-hover:translate-x-1 transition-transform" />
            </span>
            <span id="button-loading" class="hidden">
              <svg class="animate-spin h-5 w-5 inline-block mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Küldés folyamatban...
            </span>
          </button>
        </form>
      </div>

      <!-- Additional Info -->
      <div class="mt-8 text-center text-sm text-secondary-600">
        <p>Alternatív elérhetőségeink:</p>
        <p class="mt-2">
          📧 <a href="mailto:info@temetkezespro.hu" class="text-primary-600 hover:text-primary-700 underline">info@temetkezespro.hu</a>
          &nbsp;|&nbsp;
          📞 <a href="tel:+36301234567" class="text-primary-600 hover:text-primary-700 underline">+36 30 123 4567</a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Contact form submission
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
    const buttonText = document.getElementById('button-text') as HTMLElement;
    const buttonLoading = document.getElementById('button-loading') as HTMLElement;
    const formError = document.getElementById('form-error') as HTMLElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Hide error message
      formError.classList.add('hidden');

      // Disable button and show loading state
      submitButton.disabled = true;
      buttonText.classList.add('hidden');
      buttonLoading.classList.remove('hidden');

      // Get form data
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('/api/lead', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (!response.ok) {
          throw new Error('Network response was not ok');
        }

        const result = await response.json();

        if (result.success) {
          // Redirect to thank you page
          window.location.href = '/koszonjuk';
        } else {
          throw new Error(result.error || 'Unknown error');
        }
      } catch (error) {
        console.error('Form submission error:', error);
        formError.classList.remove('hidden');

        // Re-enable button
        submitButton.disabled = false;
        buttonText.classList.remove('hidden');
        buttonLoading.classList.add('hidden');
      }
    });
  });
</script>
