---
import { TrendingDown, TrendingUp } from 'lucide-astro';

const beforeStats = [
  { label: 'Napi adminisztráció', value: '3-4 óra', icon: TrendingDown },
  { label: 'Papírmunka', value: 'Rengeteg', icon: TrendingDown },
  { label: 'Telefonos egyeztetés', value: '20+ hívás/nap', icon: TrendingDown },
  { label: 'Adatvesztés kockázata', value: 'Magas', icon: TrendingDown },
];

const afterStats = [
  { label: 'Napi adminisztráció', value: '30-60 perc', icon: TrendingUp },
  { label: 'Papírmunka', value: 'Minimális', icon: TrendingUp },
  { label: 'Telefonos egyeztetés', value: '5-8 hívás/nap', icon: TrendingUp },
  { label: 'Adatvesztés kockázata', value: 'Nincs', icon: TrendingUp },
];

const benefits = [
  '75% időmegtakarítás adminisztrációban',
  'Papírmentes ügyintézés → kisebb költségek',
  'Online időpontfoglalás → több elégedett ügyfél',
  'Biztonságos adattárolás → nyugodt alvás',
  'Automatizált emlékeztetők → kevesebb lemaradás',
  '24/7 hozzáférés bárhonnan → rugalmasság',
];
---

<section class="section bg-white">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-secondary-900 mb-6">
        Előtte és Utána
      </h2>
      <p class="text-lg md:text-xl text-secondary-600">
        Így változott meg ügyfeleink mindennapi munkája a TemetkezésPro bevezetése után.
      </p>
    </div>

    <!-- Before/After Comparison -->
    <div class="grid md:grid-cols-2 gap-8 mb-16">
      <!-- Before -->
      <div class="bg-red-50 rounded-2xl p-8 border-2 border-red-100">
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-red-100 rounded-full mb-4">
            <TrendingDown class="w-8 h-8 text-red-600" />
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-red-900">Előtte</h3>
          <p class="text-red-700 mt-2">Hagyományos papíralapú ügyintézés</p>
        </div>
        <ul class="space-y-4">
          {
            beforeStats.map((stat) => (
              <li class="flex items-start">
                <div class="flex-shrink-0 w-8 h-8 bg-red-200 rounded-lg flex items-center justify-center mr-3 mt-1">
                  <stat.icon class="w-5 h-5 text-red-700" />
                </div>
                <div>
                  <div class="font-semibold text-red-900">{stat.label}</div>
                  <div class="text-red-700">{stat.value}</div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- After -->
      <div class="bg-green-50 rounded-2xl p-8 border-2 border-green-200 relative">
        {/* "Ajánlott" Badge */}
        <div class="absolute -top-4 left-1/2 -translate-x-1/2">
          <div class="bg-green-600 text-white px-4 py-1 rounded-full text-sm font-semibold">
            ✨ Ajánlott
          </div>
        </div>

        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-4">
            <TrendingUp class="w-8 h-8 text-green-600" />
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-green-900">Utána</h3>
          <p class="text-green-700 mt-2">TemetkezésPro digitális rendszer</p>
        </div>
        <ul class="space-y-4">
          {
            afterStats.map((stat) => (
              <li class="flex items-start">
                <div class="flex-shrink-0 w-8 h-8 bg-green-200 rounded-lg flex items-center justify-center mr-3 mt-1">
                  <stat.icon class="w-5 h-5 text-green-700" />
                </div>
                <div>
                  <div class="font-semibold text-green-900">{stat.label}</div>
                  <div class="text-green-700">{stat.value}</div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Key Benefits -->
    <div class="max-w-4xl mx-auto">
      <div class="bg-primary-50 rounded-2xl p-8 md:p-12">
        <h3 class="text-2xl md:text-3xl font-bold text-secondary-900 mb-2 text-center">
          Főbb előnyök számokban
        </h3>
        <p class="text-sm text-secondary-500 text-center mb-6">Tipikus pilot eredmények – nem garantált</p>
        <div class="grid md:grid-cols-2 gap-4">
          {
            benefits.map((benefit) => (
              <div class="flex items-start">
                <svg
                  class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
                <span class="text-secondary-700 text-lg">{benefit}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
