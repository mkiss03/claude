---
import { UserPlus, Settings, Rocket } from 'lucide-astro';

const steps = [
  {
    icon: UserPlus,
    step: '01',
    title: 'Regisztráció és Konzultáció',
    description:
      'Töltsön ki egy rövid űrlapot, majd egyeztessen szakértőinkkel. Megbeszéljük igényeit, beállítjuk a rendszert vállalkozása profiljához.',
  },
  {
    icon: Settings,
    step: '02',
    title: 'Integráció és Betanítás',
    description:
      'Segítünk importálni meglévő adatait, beállítjuk a sablon dokumentumokat. Online képzésen tanítjuk meg csapatát a rendszer használatára.',
  },
  {
    icon: Rocket,
    step: '03',
    title: 'Éles Indulás és Támogatás',
    description:
      'Elindítjuk a rendszert, folyamatos támogatást nyújtunk. 24/7 ügyfélszolgálat, rendszeres frissítések, ingyenes továbbfejlesztések.',
  },
];
---

<section id="mukodes" class="section bg-secondary-50">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-secondary-900 mb-6">
        Hogyan működik?
      </h2>
      <p class="text-lg md:text-xl text-secondary-600">
        3 egyszerű lépésben a digitális átállás. Végig kíséri vállalkozását szakértő csapatunk.
      </p>
    </div>

    <!-- Steps -->
    <div class="max-w-5xl mx-auto space-y-12">
      {
        steps.map((step, index) => (
          <div class="relative">
            {/* Connection Line */}
            {index < steps.length - 1 && (
              <div class="hidden md:block absolute left-[50px] top-[120px] w-0.5 h-24 bg-primary-200" />
            )}

            <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
              {/* Icon & Step Number */}
              <div class="relative flex-shrink-0">
                <div class="w-24 h-24 bg-primary-600 rounded-2xl flex items-center justify-center shadow-lg">
                  <step.icon class="w-12 h-12 text-white" />
                </div>
                <div class="absolute -top-3 -right-3 w-12 h-12 bg-secondary-900 text-white rounded-full flex items-center justify-center font-bold text-lg">
                  {step.step}
                </div>
              </div>

              {/* Content */}
              <div class="flex-1 bg-white rounded-xl shadow-md p-6 md:p-8">
                <h3 class="text-2xl md:text-3xl font-bold text-secondary-900 mb-3">{step.title}</h3>
                <p class="text-lg text-secondary-600 leading-relaxed">{step.description}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-16">
      <p class="text-lg text-secondary-600 mb-6">
        Az átállás 2-3 héten belül megtörténik, minimális zavarással a napi működésben.
      </p>
      <a href="#kapcsolat" class="btn-primary">
        Kezdjük el most
      </a>
    </div>
  </div>
</section>
